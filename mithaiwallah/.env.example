# ── Canonical origin ─────────────────────────────────────────────────────────
# Drives canonical URLs, sitemap, Open Graph and schema. Set to the real domain.
NEXT_PUBLIC_SITE_URL=https://mithaiwallah.in

# ── WhatsApp Business number ─────────────────────────────────────────────────
# Digits only, with country code, no + or spaces: 91XXXXXXXXXX.
# Left empty, every WhatsApp button falls back to the enquiry form instead of
# opening a chat with a number nobody answers.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Shown in the footer, schema and the "call" button. Same format.
NEXT_PUBLIC_PHONE_NUMBER=

# ── Lead storage: Supabase (server only — never prefix NEXT_PUBLIC_) ─────────
# The publishable key can only INSERT into mithaiwallah_leads (RLS). It cannot
# read the lead list, so a leaked key costs junk rows, not your customer data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Lead dashboard (/admin/leads) reads leads, so it needs the secret key.
# Only set this where the dashboard is deployed. Never commit it.
SUPABASE_SECRET_KEY=
# HTTP Basic Auth for /admin. Both must be set or /admin returns 404.
ADMIN_USER=
ADMIN_PASSWORD=

# ── CRM / automation webhook (optional) ──────────────────────────────────────
# Every lead is POSTed here as JSON after it is stored. Works with Zapier,
# Make, n8n, Pabbly, Zoho Flow, HubSpot workflows, or your own endpoint.
LEAD_WEBHOOK_URL=
# Sent as the X-Mithaiwallah-Signature header (HMAC-SHA256 of the body) so the
# receiver can reject forged requests.
LEAD_WEBHOOK_SECRET=

# ── Instagram live feed (optional) ───────────────────────────────────────────
# Long-lived token from the Instagram API with Instagram Login (Business or
# Creator account). Unset, the gallery shows the curated tiles in lib/instagram.ts.
INSTAGRAM_ACCESS_TOKEN=
