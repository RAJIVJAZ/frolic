# Supabase — signup collection.
#
# NOT prefixed NEXT_PUBLIC_: these are server-only and must never reach the
# browser. The publishable key is used rather than the service-role key because
# RLS restricts it to INSERT on frolic_signups and nothing else.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Canonical origin — drives canonical URLs, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://frolic.in
